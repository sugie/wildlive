APP_NAME=WildLive
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---
# For local Docker Compose development the app container reaches
# the postgres service via its service hostname `postgres`.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wildlive
DB_USERNAME=wildlive
DB_PASSWORD=wildlive_local_only

# --- Sessions / cache / queue ---
# `array` and `sync` keep the first-run experience simple and
# avoid requiring the framework migrations to be applied before
# the app can boot. Swap to `database` once persistence is needed.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

MAIL_MAILER=log

# --- Placeholder blocks ---
# Real credentials must never be committed. See SECURITY.md.
